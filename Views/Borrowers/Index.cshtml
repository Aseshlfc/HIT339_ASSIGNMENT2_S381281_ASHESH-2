@model IEnumerable<Borrower>
@{
    ViewData["Title"] = "Borrowers";
    var canManage = User.IsInRole("Reception");
    var now = DateTime.UtcNow;
}
<div class="page-heading">
    <div><h1>Borrowers</h1><p>@(canManage ? "Reception can manage borrower details and kiosk PINs." : "Set or reset a patron's kiosk PIN. Borrower details are managed by Reception.")</p></div>
    @if (canManage)
    {
        <a class="btn" asp-action="Create"><i class="bi bi-person-plus" aria-hidden="true"></i> Add Borrower</a>
    }
</div>
<div class="table-wrap">
<table>
    <thead><tr><th>Card number</th><th>Name</th><th>Email</th><th>Phone</th><th>Address</th><th>Kiosk PIN</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var b in Model)
    {
        var locked = b.KioskPinLockedUntilUtc > now;
        <tr>
            <td><code>@b.CardNumber</code></td><td>@b.FullName</td><td>@b.Email</td><td>@b.Phone</td><td>@b.Address</td>
            <td>
                @if (locked)
                {
                    <span class="status status-damaged pin-status">Locked until @b.KioskPinLockedUntilUtc!.Value.ToLocalTime().ToString("h:mm tt")</span>
                }
                else if (b.HasKioskPin)
                {
                    <span class="status status-available pin-status">Set</span>
                }
                else
                {
                    <span class="status status-borrowed pin-status">Not set</span>
                }
            </td>
            <td class="actions">
                <a class="action-btn" asp-action="KioskPin" asp-route-id="@b.Id"><i class="bi bi-key" aria-hidden="true"></i> @(b.HasKioskPin ? "Reset PIN" : "Set PIN")</a>
                @if (canManage)
                {
                    <a class="action-btn" asp-action="Edit" asp-route-id="@b.Id"><i class="bi bi-pencil-square" aria-hidden="true"></i> Edit</a>
                    <a class="action-btn action-btn-danger" asp-action="Delete" asp-route-id="@b.Id"><i class="bi bi-trash3" aria-hidden="true"></i> Delete</a>
                }
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="7">
            <div class="empty-state">
                <i class="bi bi-people" aria-hidden="true"></i>
                <strong>No borrowers yet</strong>
                Add a borrower before lending out an item.
            </div>
        </td></tr>
    }
    </tbody>
</table>
</div>
