@{
    ViewData["Title"] = "Something went wrong";
}
<div class="narrow">
    <h1><i class="bi bi-exclamation-octagon" aria-hidden="true"></i> Something went wrong</h1>
    <div class="form-card">
        <p>The request could not be completed. Nothing was changed. Please go back and try again.</p>
        <div class="button-row">
            <a class="btn" asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Return to Home</a>
        </div>
    </div>
</div>
