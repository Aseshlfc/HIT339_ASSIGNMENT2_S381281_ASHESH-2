@using LibraryManagementSystem.Controllers
@model ManagerDashboardViewModel
@{
    ViewData["Title"] = "Manager Dashboard";

    static string StatusIconFor(string statusName) => statusName switch
    {
        "Available" => "bi-check-circle-fill",
        "Borrowed" => "bi-clock-history",
        "Damaged" => "bi-exclamation-triangle-fill",
        "Destroy" => "bi-x-octagon-fill",
        "In transit" => "bi-truck",
        _ => "bi-question-circle"
    };

    static string TypeIconFor(string typeName) => typeName switch
    {
        "Books" => "bi-book",
        "Music" => "bi-disc",
        "Toys" => "bi-puzzle",
        _ => "bi-bookmark"
    };

    var reports = new[]
    {
        (Key: ManagerController.Borrowing, Action: "BorrowingReport", Icon: "bi-journal-check", Title: "Borrowing statistics", Text: "Loans by date range, category and branch, with the most borrowed items."),
        (Key: ManagerController.Fines, Action: "FineAudit", Icon: "bi-currency-dollar", Title: "Fine revenue audit", Text: "Fines assessed, paid and outstanding, listed loan by loan."),
        (Key: ManagerController.Inventory, Action: "InventoryHealth", Icon: "bi-box-seam", Title: "Inventory health", Text: "Stock by status, branch and category, and items needing attention.")
    };
}
<h1><i class="bi bi-graph-up" aria-hidden="true"></i> Manager Dashboard</h1>
<p class="help">A live snapshot of borrowing activity, item stock and fines across every branch. Open a report to filter it and export it as CSV or PDF.</p>

<div class="report-grid">
    @foreach (var r in reports)
    {
        <div class="report-card">
            <h3><i class="bi @r.Icon" aria-hidden="true"></i> @r.Title</h3>
            <p>@r.Text</p>
            <div class="button-row">
                <a class="btn btn-sm" asp-action="@r.Action"><i class="bi bi-eye" aria-hidden="true"></i> Open report</a>
                <a class="btn btn-sm btn-secondary" asp-action="Export" asp-route-report="@r.Key" asp-route-format="csv"><i class="bi bi-filetype-csv" aria-hidden="true"></i> CSV</a>
                <a class="btn btn-sm btn-secondary" asp-action="Export" asp-route-report="@r.Key" asp-route-format="pdf"><i class="bi bi-filetype-pdf" aria-hidden="true"></i> PDF</a>
            </div>
        </div>
    }
</div>

<div class="section-block">
    <h2><i class="bi bi-journal-check" aria-hidden="true"></i> Borrowing statistics</h2>
    <div class="stats-grid">
        <div class="stat-card"><span><i class="bi bi-collection" aria-hidden="true"></i> Total loans</span><strong>@Model.TotalLoans</strong></div>
        <div class="stat-card"><span><i class="bi bi-hourglass-split" aria-hidden="true"></i> Active loans</span><strong>@Model.ActiveLoans</strong></div>
        <div class="stat-card"><span><i class="bi bi-check2-circle" aria-hidden="true"></i> Returned loans</span><strong>@Model.ReturnedLoans</strong></div>
        <div class="stat-card @(Model.OverdueLoans > 0 ? "stat-warn" : "")"><span><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Overdue loans</span><strong>@Model.OverdueLoans</strong></div>
    </div>
</div>

<div class="section-block">
    <h2><i class="bi bi-box-seam" aria-hidden="true"></i> Inventory</h2>
    <div class="stats-grid">
        <div class="stat-card"><span><i class="bi bi-collection" aria-hidden="true"></i> Total inventory</span><strong>@Model.TotalItems</strong></div>
    @foreach (var x in Model.StatusCounts)
    {
        <div class="stat-card @((x.Key is "Damaged" or "Destroy") && x.Value > 0 ? "stat-warn" : "")"><span><i class="bi @StatusIconFor(x.Key)" aria-hidden="true"></i> @x.Key</span><strong>@x.Value</strong></div>
    }
    </div>

    <h2 style="margin-top:26px;"><i class="bi bi-tags" aria-hidden="true"></i> Item type statistics</h2>
    <div class="stats-grid">
    @foreach (var x in Model.TypeCounts)
    {
        <div class="stat-card"><span><i class="bi @TypeIconFor(x.Key)" aria-hidden="true"></i> @x.Key</span><strong>@x.Value</strong></div>
    }
    </div>
</div>

<div class="section-block">
    <h2><i class="bi bi-buildings" aria-hidden="true"></i> Branches</h2>
    <p class="help">Inventory currently held at each branch and loans issued there. @Model.OpenTransfers open transfer@(Model.OpenTransfers == 1 ? "" : "s") between branches.</p>
    <div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Branch</th><th class="num">Items</th><th class="num">Available</th><th class="num">Borrowed</th><th class="num">In transit</th>
                <th class="num">Out of service</th><th class="num">Loans issued</th><th class="num">Active</th><th class="num">Overdue</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var b in Model.Branches)
        {
            <tr>
                <td>@b.Name @if (!b.IsActive) { <small>(inactive)</small> }</td>
                <td class="num">@b.Items</td><td class="num">@b.Available</td><td class="num">@b.Borrowed</td><td class="num">@b.InTransit</td>
                <td class="num">@b.OutOfService</td><td class="num">@b.LoansIssued</td><td class="num">@b.ActiveLoans</td><td class="num">@b.OverdueLoans</td>
            </tr>
        }
        @if (!Model.Branches.Any())
        {
            <tr><td colspan="9"><div class="empty-state"><i class="bi bi-buildings" aria-hidden="true"></i><strong>No branches yet</strong>Branches appear here once they are created.</div></td></tr>
        }
        </tbody>
    </table>
    </div>
    @if (Model.LoansWithoutBranch > 0)
    {
        <p class="help" style="margin-top:12px;"><i class="bi bi-info-circle" aria-hidden="true"></i> @Model.LoansWithoutBranch loan@(Model.LoansWithoutBranch == 1 ? " was" : "s were") made before the library recorded an issuing branch, so @(Model.LoansWithoutBranch == 1 ? "it is" : "they are") not counted against any branch.</p>
    }
</div>

<div class="section-block">
    <h2><i class="bi bi-currency-dollar" aria-hidden="true"></i> Fine statistics</h2>
    <div class="stats-grid">
        <div class="stat-card"><span><i class="bi bi-cash-stack" aria-hidden="true"></i> Total assessed</span><strong>$@Model.TotalFines.ToString("0.00")</strong></div>
        <div class="stat-card"><span><i class="bi bi-check2-circle" aria-hidden="true"></i> Paid</span><strong>$@Model.PaidFines.ToString("0.00")</strong></div>
        <div class="stat-card @(Model.OutstandingFines > 0 ? "stat-warn" : "")"><span><i class="bi bi-exclamation-circle" aria-hidden="true"></i> Outstanding</span><strong>$@Model.OutstandingFines.ToString("0.00")</strong></div>
    </div>
</div>

<div class="section-block">
    <h2><i class="bi bi-star" aria-hidden="true"></i> Most borrowed items</h2>
    <div class="table-wrap">
    <table>
        <thead><tr><th>Item</th><th>Library code</th><th class="num">Times borrowed</th></tr></thead>
        <tbody>
        @foreach (var row in Model.PopularItems)
        {
            <tr><td>@row.Name</td><td>@row.LibraryCode</td><td class="num">@row.BorrowCount</td></tr>
        }
        @if (!Model.PopularItems.Any())
        {
            <tr><td colspan="3">
                <div class="empty-state">
                    <i class="bi bi-star" aria-hidden="true"></i>
                    <strong>No borrowing activity yet</strong>
                    Popular items will appear here once loans start being recorded.
                </div>
            </td></tr>
        }
        </tbody>
    </table>
    </div>
</div>
