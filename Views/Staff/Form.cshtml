@model StaffFormViewModel
@{
    var isEdit = !string.IsNullOrEmpty(Model.Id);
    ViewData["Title"] = isEdit ? "Edit Staff Account" : "Add Staff Account";
    var branches = (List<Branch>)ViewBag.Branches;
}

<div class="narrow">

    <h1><i class="bi @(isEdit ? "bi-pencil-square" : "bi-person-plus")" aria-hidden="true"></i> @ViewData["Title"]</h1>

    <form method="post" asp-action="@(isEdit ? "Edit" : "Create")" class="form-card">

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <div class="field">
            <label asp-for="UserName">Username</label>
            <input asp-for="UserName" />
            <span asp-validation-for="UserName" class="validation"></span>
        </div>

        <div class="field">
            <label asp-for="Role"></label>
            <select asp-for="Role">
                <option value="Admin">Admin</option>
                <option value="Reception">Reception</option>
                <option value="Manager">Manager</option>
            </select>
            <span asp-validation-for="Role" class="validation"></span>
        </div>

        <div class="field">
            <label asp-for="BranchId"></label>
            <select asp-for="BranchId">
                <option value="">Not assigned to a branch</option>
                @foreach (var b in branches)
                {
                    <option value="@b.Id">@b.Name (@b.Code)</option>
                }
            </select>
            <span class="field-hint">Reception staff work at their branch's desk: they lend that branch's items and handle its transfers.</span>
            <span asp-validation-for="BranchId" class="validation"></span>
        </div>

        <div class="field">
            <label asp-for="Password">@(isEdit ? "New password (leave blank to keep unchanged)" : "Password")</label>
            <input asp-for="Password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="validation"></span>
        </div>

        <div class="button-row">
            <button class="btn" type="submit"><i class="bi bi-check2" aria-hidden="true"></i> Save</button>
            <a class="btn btn-secondary" asp-action="Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Staff Accounts</a>
        </div>

    </form>

</div>
