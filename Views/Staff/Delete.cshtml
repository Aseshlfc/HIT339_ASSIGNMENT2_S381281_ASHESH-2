@model StaffListItemViewModel
@{
    ViewData["Title"] = "Delete Staff Account";
}
<div class="narrow">
    <h1><i class="bi bi-trash3" aria-hidden="true"></i> Delete Staff Account</h1>
    <div class="form-card">
        <p>Are you sure you want to delete <strong>@Model.UserName</strong> (@Model.Role)?</p>
        <p class="help"><i class="bi bi-info-circle" aria-hidden="true"></i> Consider disabling the account instead if you may need it again.</p>
        <form method="post">
            <div class="button-row">
                <button class="btn btn-danger" type="submit"><i class="bi bi-trash3" aria-hidden="true"></i> Delete</button>
                <a class="btn btn-secondary" asp-action="Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Staff Accounts</a>
            </div>
        </form>
    </div>
</div>
