@model ReturnViewModel
@{
    ViewData["Title"] = "Return Item";
}
<div class="narrow">
<h1><i class="bi bi-box-arrow-in-left" aria-hidden="true"></i> Return Item</h1>
<form method="post" class="form-card">
    <input asp-for="LoanId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <dl>
        <dt>Item</dt><dd>@Model.ItemName (@Model.LibraryCode)</dd>
        <dt>Borrower</dt><dd>@Model.BorrowerName</dd>
        <dt>Due date</dt><dd>@Model.DueDate.ToString("dd MMM yyyy")</dd>
    </dl>
    @if (Model.EstimatedFine > 0)
    {
        <div class="fine-highlight"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> Late fine due today: $@Model.EstimatedFine.ToString("0.00")</div>
    }
    else
    {
        <div class="fine-highlight zero"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> No late fine &mdash; on time</div>
    }
    @if (ViewBag.IsCrossBranchReturn == true)
    {
        <div class="desk-note"><i class="bi bi-arrow-left-right" aria-hidden="true"></i> This item is held at @ViewBag.ItemBranchName. Returning it here will record it as now held at @(((Branch)ViewBag.StaffBranch).Name), and the move will appear in its movement history.</div>
    }
    <div class="field">
        <label asp-for="ReturnStatus">Item condition/status after return</label>
        <select asp-for="ReturnStatus">
            <option value="Available">Available</option>
            <option value="Damaged">Damaged</option>
            <option value="Destroy">Destroy</option>
        </select>
        <span asp-validation-for="ReturnStatus" class="validation"></span>
    </div>
    <div class="button-row">
        <button class="btn" type="submit"><i class="bi bi-check2" aria-hidden="true"></i> Complete Return</button>
        <a class="btn btn-secondary" asp-action="Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Loans</a>
    </div>
</form>
</div>
