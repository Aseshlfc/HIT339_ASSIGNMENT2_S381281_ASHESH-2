@model KioskWelcomeViewModel
@{
    ViewData["Title"] = "Welcome";
    ViewData["KioskBranchName"] = Model.Branch.Name;
    Layout = "_KioskLayout";
}
<section class="kiosk-panel kiosk-welcome">
    <h1>Welcome</h1>
    <p class="kiosk-lead">Scan your library card, or type your card number, to borrow items and see your account.</p>

    @if (Model.SignedOut)
    {
        <div class="kiosk-message kiosk-success" role="status"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> You have signed out. Thank you for visiting.</div>
    }

    @if (Model.Error != null)
    {
        <div class="kiosk-message kiosk-error" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @Model.Error</div>
    }

    <form method="post" asp-action="OpenAccount" asp-route-branchCode="@Model.Branch.Code" class="kiosk-form" id="kioskSignIn">
        <input type="hidden" name="SignInToken" value="@Model.SignInToken" />
        <label for="CardNumber" class="kiosk-label">Library card number</label>
        <div class="kiosk-input-row">
            <i class="bi bi-upc-scan" aria-hidden="true"></i>
            <input id="CardNumber" name="CardNumber" value="@Model.CardNumber" autofocus autocomplete="off"
                   autocapitalize="characters" spellcheck="false" enterkeyhint="go" placeholder="e.g. P0001" />
        </div>
        <button type="submit" class="kiosk-btn"><i class="bi bi-arrow-right-circle-fill" aria-hidden="true"></i> Continue</button>
    </form>

    <p class="kiosk-hint">A barcode scanner types the number for you and presses Enter automatically.</p>

    @* Only on this screen, where no patron is signed in, so leaving never carries an account with it. *@
    <nav class="kiosk-exit" aria-label="Leave the kiosk">
        <a class="kiosk-btn kiosk-btn-secondary" href="@Url.Action("Index", "Home")">
            <i class="bi bi-house-door-fill" aria-hidden="true"></i> Back to Main Site
        </a>
    </nav>
</section>

@section Scripts {
<script>
    // Each welcome screen can sign in once. If the browser brings back an old copy
    // (Back button), or this screen has been waiting a long time, load a fresh one.
    (function () {
        window.addEventListener('pageshow', function (e) {
            if (e.persisted) window.location.reload();
        });
        const card = document.getElementById('CardNumber');
        setInterval(function () {
            if (card.value === '') window.location.reload();
        }, 30 * 60 * 1000);
    })();
</script>
}
