@model List<Branch>
@{
    ViewData["Title"] = "Choose a branch";
    Layout = "_KioskLayout";
}
<section class="kiosk-panel">
    <h1>Self-service kiosk</h1>
    <p class="kiosk-lead">Choose the library you are visiting today.</p>
    @if (Model.Count == 0)
    {
        <div class="kiosk-message kiosk-error"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> There are no active branches. Please ask library staff.</div>
    }
    <div class="kiosk-branch-grid">
        @foreach (var branch in Model)
        {
            <a class="kiosk-btn kiosk-btn-wide" asp-action="Welcome" asp-route-branchCode="@branch.Code">
                <i class="bi bi-geo-alt-fill" aria-hidden="true"></i> @branch.Name
            </a>
        }
    </div>
    @* Staff set each kiosk to open at its branch (/kiosk/<branch code>); that instruction
       lives in the Section 2 user guide, not on the patron's screen. *@

    <partial name="_BackToMainSite" />
</section>
