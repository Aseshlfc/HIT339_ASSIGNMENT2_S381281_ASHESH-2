@{
    ViewData["Title"] = "Branch not found";
    Layout = "_KioskLayout";
}
<section class="kiosk-panel">
    <h1>Branch not found</h1>
    <div class="kiosk-message kiosk-error"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> This kiosk is not linked to an active branch. Please ask library staff.</div>
    <a class="kiosk-btn" asp-action="Index"><i class="bi bi-arrow-left-circle-fill" aria-hidden="true"></i> Choose a branch</a>

    <partial name="_BackToMainSite" />
</section>
